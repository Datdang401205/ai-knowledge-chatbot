# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# LLM local qua Ollama (tùy chọn, mặc định dùng generator extractive)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Chọn backend: hashing | ollama
EMBEDDING_PROVIDER=hashing
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chọn generator: extractive | ollama
LLM_PROVIDER=extractive

# Chunking và retrieval
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.25

# API
API_HOST=127.0.0.1
API_PORT=8000
